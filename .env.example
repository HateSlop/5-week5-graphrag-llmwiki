# .env로 복사한 뒤 실행할 환경에서만 값을 채우세요.
# OPENAI_API_KEY 하나를 01·03·04의 선택 API 호출에 함께 사용합니다.
# 비워 두면 API를 쓰는 셀/명령은 실행되지 않습니다.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
GRAPHRAG_CHAT_MODEL=gpt-4o-mini
GRAPHRAG_EMBED_MODEL=text-embedding-3-small
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
